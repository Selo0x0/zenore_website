{
  "name": "zenore-website",
  "version": "0.1.0",
  "private": true,
  "description": "Zenore single-seller Turkish leather e-commerce platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
      "dev": "npm run dev:web",
      "dev:web": "npm run dev -w apps/web",
      "build": "npm run build:web",
      "build:web": "npm run build -w apps/web",
      "lint": "npm run lint:web",
      "lint:web": "npm run lint -w apps/web",
      "typecheck": "npm run typecheck:web",
      "typecheck:web": "npm exec -w apps/web tsc -- --noEmit"
    },
    "engines": {
      "node": ">=20.0.0",
      "npm": ">=10.0.0"
    }
}