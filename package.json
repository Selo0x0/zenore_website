{
  "name": "zenore-website",
  "version": "0.1.0",
  "private": true,
  "description": "Zenore single-seller Turkish leather e-commerce platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:web": "npm run lint -w apps/web",
    "lint:api": "npm run lint -w apps/api",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "typecheck:web": "npm exec -w apps/web tsc -- --noEmit",
    "typecheck:api": "npm exec -w apps/api tsc -- --noEmit",
    "test": "npm run test:api",
    "test:api": "npm test -w apps/api",
    "db:generate": "npm run db:generate -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db --",
    "db:studio": "npm run db:studio -w packages/db",
    "db:validate": "npm run db:validate -w packages/db",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
