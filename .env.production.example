# Copy this to .env.production and fill in real values before deploying.
# .env.production is gitignored — never commit real secrets.
#
# Usage:
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# Your domain, e.g. zenore.com (Caddy fetches an HTTPS cert for it automatically).
# Before you have a domain, set this to your server's public IP instead — Caddy
# serves plain HTTP for IP addresses (no cert is possible for a bare IP), which
# is why PUBLIC_SCHEME below must be set to "http" in that case.
DOMAIN=localhost

# Set to "http" while testing via DOMAIN=<server-ip> with no domain yet.
# Switch back to "https" (or remove this line) once DOMAIN is a real domain.
PUBLIC_SCHEME=https

POSTGRES_PASSWORD=change-me

# Firebase Admin SDK (server-side, used by the API)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Brevo (transactional email, e.g. order confirmations). BREVO_FROM_EMAIL
# must be a verified sender/domain in your Brevo account.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Where contact-form submissions get emailed to.
ADMIN_EMAIL=

# Firebase Web SDK (client-side — baked into the web image at build time,
# so the web image must be rebuilt whenever these change)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sentry (or a Sentry-compatible self-hosted DSN, e.g. from Bugsink below)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Bugsink (self-hosted, Sentry-compatible error tracking, served at
# bugs.<DOMAIN>). Generate your own BUGSINK_SECRET_KEY, don't reuse this one —
# e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(50))"`
BUGSINK_SECRET_KEY=change-me-generate-a-random-value
BUGSINK_DB_PASSWORD=change-me
BUGSINK_ADMIN_EMAIL=you@example.com
BUGSINK_ADMIN_PASSWORD=change-me

# Payment provider — PayTR. PAYMENT_API_KEY = merchant_key (Mağaza Parola),
# PAYMENT_SECRET_KEY = merchant_salt (Mağaza Gizli Anahtarı). Get these from
# the PayTR merchant panel under "Entegrasyon Bilgileri". Set PAYTR_TEST_MODE=0
# only once you're ready to take real payments.
PAYMENT_PROVIDER=paytr
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYTR_TEST_MODE=1
