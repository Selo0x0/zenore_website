# Copy this to .env.production and fill in real values before deploying.
# .env.production is gitignored — never commit real secrets.
#
# Usage:
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# Your domain, e.g. zenore.com (Caddy fetches an HTTPS cert for it automatically).
# Before you have a domain, set this to your server's public IP instead — Caddy
# serves plain HTTP for IP addresses (no cert is possible for a bare IP), which
# is why PUBLIC_SCHEME below must be set to "http" in that case.
DOMAIN=localhost

# Set to "http" while testing via DOMAIN=<server-ip> with no domain yet.
# Switch back to "https" (or remove this line) once DOMAIN is a real domain.
PUBLIC_SCHEME=https

POSTGRES_PASSWORD=change-me

# Firebase Admin SDK (server-side, used by the API)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend (transactional email, e.g. order confirmations)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Firebase Web SDK (client-side — baked into the web image at build time,
# so the web image must be rebuilt whenever these change)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Payment provider (iyzico or PayTR) — added when that integration is built
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
